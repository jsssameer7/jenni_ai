# Jenni AI Configuration
PROJECT_NAME="Jenni AI"
APP_TITLE="Jenni AI — Your Personal Assistant"
VERSION="1.0.0"

# Server Settings
HOST="0.0.0.0"
PORT=8000
LAPTOP_TAILSCALE_IP="100.102.38.116"
PHONE_TAILSCALE_IP="100.74.215.8"

# Security & Authentication
# Change this secret key in production
SECRET_KEY="jenni_secret_production_key_replace_me"
# Token required by remote clients (Android phone / Tailscale)
AUTH_TOKEN="jenni-mobile-token-2026"
REQUIRE_AUTH_FOR_LOCAL=false
REQUIRE_AUTH_FOR_REMOTE=true

# Local Ollama LLM
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_TIMEOUT=60.0

# Optional Online AI Provider (set to "openai" or "groq" if desired)
ONLINE_AI_PROVIDER="none"
ONLINE_AI_API_KEY=""
ONLINE_AI_MODEL="gpt-4o-mini"

# ComfyUI Image Generation
COMFYUI_URL="http://127.0.0.1:8188"

# Voice & TTS
DEFAULT_GREETING="Hello! I'm Jenni AI. How can I help you today?"
TTS_RATE=180
TTS_VOLUME=1.0
DEFAULT_LANGUAGE="en-US"
